# ===== 应用 =====
APP_NAME=TrendRadar
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# 用于 JWT 与敏感字段加密，生产环境必须替换：openssl rand -hex 32
SECRET_KEY=change-me-in-production-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET_KEY=change-me-too-fedcba9876543210fedcba9876543210
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 数据库 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trendradar
POSTGRES_PASSWORD=trendradar
POSTGRES_DB=trendradar
DATABASE_ECHO=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== Celery =====
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
CELERY_TIMEZONE=Asia/Shanghai

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 初始管理员（seed 脚本使用）=====
INITIAL_ADMIN_EMAIL=admin@trendradar.dev
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin1234!

# ===== Embedding =====
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DIM=1024
